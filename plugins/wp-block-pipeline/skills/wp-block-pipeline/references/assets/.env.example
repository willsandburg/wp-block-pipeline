# WordPress block pipeline — local environment
# Copy to .env and adjust. Never commit .env.

# --- Access -----------------------------------------------------------------
# Port mode (default). Change both together if 8080 is taken.
WP_PORT=8080
PMA_PORT=8081
WP_URL=http://localhost:8080

# Domain mode (optional — see references/local-environment.md).
# Uncomment these and comment out WP_URL above.
#WP_URL=http://{slug}.loc
#SITE_HOST={slug}.loc
#COMPOSE_PROJECT_NAME={slug}
#COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml
# On Windows the COMPOSE_FILE separator is a semicolon, not a colon.

# --- Database ---------------------------------------------------------------
# Local only. Empty passwords are intentional; nothing here reaches production.
DB_DATABASE={slug}
DB_USERNAME={slug}
DB_PASSWORD=

# --- WordPress --------------------------------------------------------------
WP_TITLE={Site name}
WP_TAGLINE=
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@{domain}
WP_TIMEZONE=UTC

# Pinned by name on purpose. Twenty Twenty-Seven becomes the default on new
# installs when WordPress 7.2 ships — this keeps that from silently changing
# what the generated styles render against.
WP_THEME=twentytwentyfive

# Receiver plugin folder name. Leave empty until the plugin exists; the
# pipeline works on core REST endpoints without it.
PLUGIN_SLUG=
